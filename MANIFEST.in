recursive-include tests *.py *.html
exclude response_pool.csv gformbot_config.yaml gformbot_log.csv gformbot-runs.csv
exclude gformbot-responses*.json gformbot-generated*.csv gformbot-additional*.csv
exclude gformbot-export*.csv gformbot-partial*.csv gformbot-generation*.json gformbot-generation*.json.lock
include CHANGELOG.md
prune .work
prune .venv
